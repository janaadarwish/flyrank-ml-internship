      "source": [
        "## 2. Build the ranked queue (writes the CSV)\n",
        "\n",
        "*Code the score, rank everything, write work/outputs/baseline_action_score.csv.*"
      ],
      "id": "GUStWElxfU9c"
    },
    {
      "cell_type": "code",
      "execution_count": 17,
      "metadata": {
        "id": "D1pM7WxtfU9d",
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "outputId": "862fc952-3fd0-4e63-f2fe-190c21f5246f"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Signal 1: days since last update (refresh flag)\n",
            "                 n   rate\n",
            "stale_bucket             \n",
            "0-23 days     2399  0.587\n",
            "24-60 days      93  0.591\n",
            "61+ days        34  0.765 \n",
            "\n",
            "Signal 2: early-window impressions (quick-win flag)\n",
            "                     n   rate\n",
            "vol_bucket                   \n",
            "(55.999, 1107.0]   506  0.662\n",
            "(1107.0, 1765.0]   506  0.619\n",
            "(1765.0, 2953.0]   504  0.601\n",
            "(2953.0, 6318.0]   505  0.564\n",
            "(6318.0, 75924.0]  505  0.503 \n",
            "\n",
            "Extra check: CTR vs peers at the same position (CTR-fix flag)\n",
            "                    n   rate\n",
            "ctr_gap_bucket              \n",
            "(0.00098, 0.202]  506  0.577\n",
            "(0.202, 0.401]    505  0.590\n",
            "(0.401, 0.601]    505  0.570\n",
            "(0.601, 0.8]      505  0.626\n",
            "(0.8, 1.0]        505  0.586\n"
          ]
        }
      ],
      "source": [
        "print(\"Signal 1: days since last update (refresh flag)\")\n",
        "df[\"stale_bucket\"] = pd.cut(df[\"days_since_update\"], [-1, 23, 60, 400], labels=[\"0-23 days\", \"24-60 days\", \"61+ days\"])\n",
        "print(df.groupby(\"stale_bucket\", observed=True)[\"label\"].agg(n=\"size\", rate=\"mean\").round(3), \"\\n\")\n",
        "\n",
        "print(\"Signal 2: early-window impressions (quick-win flag)\")\n",
        "df[\"vol_bucket\"] = pd.qcut(df[\"impressions_early\"], 5, duplicates=\"drop\")\n",
        "print(df.groupby(\"vol_bucket\", observed=True)[\"label\"].agg(n=\"size\", rate=\"mean\").round(3), \"\\n\")\n",
        "\n",
        "print(\"Extra check: CTR vs peers at the same position (CTR-fix flag)\")\n",
        "df[\"pos_bucket\"] = pd.qcut(df[\"avg_position_early\"], 5, duplicates=\"drop\")\n",
        "df[\"ctr_vs_peers\"] = df.groupby(\"pos_bucket\", observed=True)[\"ctr_early\"].rank(pct=True)\n",
        "df[\"ctr_gap_bucket\"] = pd.qcut(df[\"ctr_vs_peers\"], 5, duplicates=\"drop\")\n",
        "print(df.groupby(\"ctr_gap_bucket\", observed=True)[\"label\"].agg(n=\"size\", rate=\"mean\").round(3))"
      ],
      "id": "D1pM7WxtfU9d"
    },
