      "source": [
        "def pct(s): return s.rank(pct=True)\n",
        "\n",
        "volume_part = 1 - pct(df[\"impressions_early\"])   # lower volume -> higher score (OPPOSITE to quick-win)\n",
        "stale_part  = pct(df[\"days_since_update\"])       # staler -> higher score (MIXED, small weight)\n",
        "W_VOL, W_STALE = 0.8, 0.2\n",
        "df[\"score\"] = W_VOL * volume_part + W_STALE * stale_part\n",
        "df[\"reason_code\"] = np.where(W_VOL * volume_part >= W_STALE * stale_part, \"LOW_VOLUME_DECLINE_RISK\", \"STALE_CONTENT\")\n",
        "df[\"action\"] = np.where(df[\"reason_code\"] == \"LOW_VOLUME_DECLINE_RISK\", \"Review page performance\", \"Refresh content\")\n",
        "print(df[\"reason_code\"].value_counts())\n",
        "\n",
        "os.makedirs(\"work/outputs\", exist_ok=True)\n",
        "ranked = df.sort_values(\"score\", ascending=False).reset_index(drop=True)\n",
        "ranked[[\"client_hash_id\", \"content_hash_id\", \"score\", \"reason_code\", \"action\"]].to_csv(\"work/outputs/baseline_action_score.csv\", index=False)\n",
        "\n",
        "metrics = {\"n_rows\": int(len(df)), \"base_rate\": round(float(df[\"label\"].mean()), 3),\n",
        "           \"baseline_precision_at_50\": round(float(ranked.head(50)[\"label\"].mean()), 3)}\n",
        "json.dump(metrics, open(\"work/outputs/w04_baseline_metrics.json\", \"w\"), indent=2)\n",
        "print(metrics)\n",
        "\n",
        "ranked.head(10)[[\"content_hash_id\", \"impressions_early\", \"days_since_update\", \"ctr_early\",\n",
        "                 \"avg_position_early\", \"reason_code\", \"action\"]].round(4)"
